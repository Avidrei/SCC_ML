    "    # -------------------------------\n",
    "    df = pd.DataFrame(all_results)\n",
    "    csv_name = os.path.join(model_dir, f\"{model_name}_kfold_hparam_results.csv\")\n",
    "    df.to_csv(csv_name, index=False)\n",
    "    print(f\"\\n📄 Saved all hyperparam+CV results: {csv_name}\")\n",
    "\n",
    "    return df\n"
   ]
